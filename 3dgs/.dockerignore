# =============================================================================
# .dockerignore — 减少构建上下文体积、排除旧编译产物
# =============================================================================

# Git / IDE
.git
.gitignore
.gitmodules
.idea/
.vscode/
*.swp

# 旧编译产物（Python 3.8 的 .so，Dockerfile 里会重新编）
**/__pycache__/
**/*.pyc
**/*.so
**/*.o
**/*.a
build/
*.egg-info/
dist/

# 无关大文件
assets/
results.md
LICENSE.md
README.md

# 用户数据（不在构建时拷贝进镜像）
datasets/
output/
data/
*.zip
*.tar.gz
